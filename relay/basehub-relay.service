[Unit]
Description=Basehub Remote relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/basehub-relay
Environment=RELAY_LISTEN=0.0.0.0:8790
Environment=RELAY_TRUST_PROXY=1
DynamicUser=yes
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
